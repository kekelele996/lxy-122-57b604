# Compose 项目名（小写字母/数字/-/_），避免中文目录名导致 project name must not be empty
COMPOSE_PROJECT_NAME=gb122

# SQLite 项目保留统一数据库变量，DB_PORT 不映射到宿主机
DB_NAME=gb122_sqlite
DB_USER=app
DB_PASSWORD=app_pwd
DB_ROOT_PASSWORD=root_pwd
DB_PORT=0

JWT_SECRET=change_me_to_a_long_random_string_gb122

FRONTEND_PORT=18122
BACKEND_PORT=19122
BACKEND_INTERNAL_PORT=3000
